{
  "name": "logic-game",
  "private": true,
  "type": "module",
  "description": "A logic game played with answer set programs (clingo in the browser).",
  "homepage": "https://rdehaan.github.io/logic-game/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rdehaan/logic-game.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "logic-game": "bin/logic-game.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:unit": "node --test \"test/!(browser).test.mjs\"",
    "test:browser": "node --test test/browser.test.mjs",
    "lint": "eslint .",
    "vendor": "node tools/vendor.mjs",
    "serve": "node tools/serve.mjs",
    "game": "node bin/logic-game.mjs"
  },
  "dependencies": {
    "clingo-wasm": "0.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/open-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "ace-builds": "1.45.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "playwright": "^1.50.0"
  }
}
